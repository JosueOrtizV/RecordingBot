# Node environment
NODE_ENV=production

# Meeting Recording & Bot Configuration
BOT_DISPLAY_NAME=Josue's Notetaker
MAX_RECORDING_DURATION_MINUTES=180
MEETING_INACTIVITY_MINUTES=3
INACTIVITY_DETECTION_START_DELAY_MINUTES=5
JOIN_WAIT_TIME_MINUTES=5
RETRY_COUNT=2
GOOGLE_ANONYMOUS_JOIN_REQUEST_ATTEMPTS=10

# Storage Provider (use 'drive' for Google Drive, or 's3'/'azure')
STORAGE_PROVIDER=drive

# Google Drive and Calendar Settings
GOOGLE_CREDENTIALS_PATH=/app/credentials.json
GOOGLE_TOKEN_PATH=/app/token.json
GOOGLE_DRIVE_FOLDER_NAME=RecordingBot

# Chrome / CDP Configuration
# Inside Docker Compose network, meeting-bot talks to chrome-cdp
GOOGLE_CHROME_CDP_URL=http://chrome-cdp:9223

# Redis Queue Configuration
REDIS_CONSUMER_ENABLED=true
REDIS_QUEUE_NAME=jobs:meetbot:list
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Telegram Alerts (for scheduler and watchdogs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifications
NOTIFY_REDIS_ENABLED=true
NOTIFY_REDIS_LIST=jobs:meetbot:recordings
NOTIFY_REDIS_FAILURE_LIST=jobs:meetbot:failures

# Telegram Alert Configuration (uses VPS telegram alert script)
TELEGRAM_ALERT_SCRIPT=/root/scripts/telegram_alert.sh

# Scheduler Polling
CALENDAR_POLL_INTERVAL_MINUTES=2
LEAD_TIME_MINUTES=5
TIMEZONE=America/Mexico_City

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=recordingbot
POSTGRES_PASSWORD=recordingbot_secure_password
POSTGRES_DB=recordingbot

# Dashboard API & Web OAuth Configuration
PORT=3002
JWT_SECRET=recordingbot_super_secret_jwt_key_2026
FRONTEND_URL=https://recordingbot.josueortiz.dev
GOOGLE_CLIENT_ID=334347434150-qao1bka151lmg278qoa3tdvc7ilu54gp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=https://api.recordingbot.josueortiz.dev/auth/google/callback
ALLOWED_EMAIL_DOMAINS=clevercloud.mx

